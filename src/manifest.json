{
  "manifest_version": 3,
  "name": "遗产地图插件 — Heritage Map Plugin",
  "version": "0.5.2",
  "description": "在中国遗产地图 (stele.geogv.org) 的文保点位详情页，叠加高德/百度地图的开放时间、票价与地址。文物组请点进子项目查看。",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "host_permissions": [
    "https://restapi.amap.com/*",
    "https://api.map.baidu.com/*",
    "https://api.github.com/*",
    "https://cdn.jsdelivr.net/*"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "遗产地图插件 — 打开配置与收藏",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://stele.geogv.org/zhcn/*"
      ],
      "js": [
        "shared/favorites-store.js",
        "content/decoder.js",
        "content/naming.js",
        "content/geo.js",
        "content/cache.js",
        "content/http.js",
        "content/apis/amap.js",
        "content/apis/baidu.js",
        "content/name-evidence.js",
        "content/matcher.js",
        "content/decision-log.js",
        "content/card.js",
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": []
}
